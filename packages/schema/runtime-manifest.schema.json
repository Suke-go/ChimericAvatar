{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimera-presenter.local/schema/runtime-manifest.schema.json",
  "title": "Chimera Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionCode", "tracking", "assets", "posterPanels", "presentationCues", "avatar", "scripts", "qa"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "sessionCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6,12}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "tracking": {
      "$ref": "#/$defs/tracking"
    },
    "avatar": {
      "$ref": "#/$defs/avatar"
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "posterPanels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/posterPanel"
      }
    },
    "presentationCues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/presentationCue"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scriptProfile"
      }
    },
    "qa": {
      "$ref": "#/$defs/qa"
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "incomplete": {
      "type": "boolean",
      "description": "True when at least one blocker or missing-asset entry is present. Consumers should still attempt to load the manifest; this is a hint to surface 'this session is not fully prepared' UI."
    },
    "blockers": {
      "type": "array",
      "description": "Stable string codes for hard-requirement gaps (poster config absent, no approved script, etc.). The dashboard uses these to render a per-tab checklist.",
      "items": {
        "type": "string"
      }
    },
    "missing": {
      "type": "array",
      "description": "Per-asset entries for storage objects that could not be signed. Populated when DB has an asset row but the bucket / filesystem reports it missing — the API auto-marks Asset.status=missing when this happens.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reason"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "assetId": { "type": ["string", "null"] },
          "fileName": { "type": ["string", "null"] },
          "reason": {
            "type": "string",
            "enum": ["object_not_found", "asset_record_missing"]
          }
        }
      }
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "signedAsset": {
      "type": "object",
      "additionalProperties": false,
      "description": "Signed download URL for a runtime asset. When the storage object cannot be signed, the API still emits a payload with `url: null` and `missing: true` (and adds an entry to the top-level `missing` array). Consumers must check `missing` before attempting `url`.",
      "required": ["id"],
      "properties": {
        "id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "url": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "mimeType": {
          "type": ["string", "null"]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "fileName": {
          "type": ["string", "null"]
        },
        "missing": {
          "type": "boolean",
          "default": false
        },
        "missingReason": {
          "type": ["string", "null"],
          "enum": ["object_not_found", "asset_record_missing", null]
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Top-level signed assets. `posterImage` may be omitted entirely when the session has no poster image configured yet — the dashboard's Preview tab tolerates this. When present but missing from storage, it carries `missing: true`.",
      "properties": {
        "posterImage": {
          "$ref": "#/$defs/signedAsset"
        },
        "qrMarker": {
          "$ref": "#/$defs/signedAsset"
        }
      }
    },
    "posterPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "orderIndex", "bbox", "localBoundsM"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "orderIndex": {
          "type": "integer",
          "minimum": 0
        },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "localBoundsM": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center", "size"],
          "properties": {
            "center": { "$ref": "#/$defs/vec3" },
            "size": { "$ref": "#/$defs/vec2" }
          }
        }
      }
    },
    "presentationCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "startMs", "payload"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "segmentId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["panel_focus", "pointer_move", "caption_show", "caption_hide", "audio_play", "qr_show", "ui_panel_show"]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "referenceImageName", "posterFormat", "orientation", "physicalSizeM", "anchorOffset"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fiducial-software-anchor", "xreal-image-tracking", "manual-anchor", "qr-anchor"]
        },
        "referenceImageName": {
          "type": "string",
          "minLength": 1
        },
        "markerCountPolicy": {
          "type": "string",
          "enum": ["single-primary", "single-primary-plus-optional-relock", "multi-marker-lab"]
        },
        "posterFormat": {
          "type": "string",
          "enum": ["A0"]
        },
        "orientation": {
          "type": "string",
          "enum": ["portrait", "landscape"]
        },
        "physicalSizeM": {
          "$ref": "#/$defs/vec2"
        },
        "fiducials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fiducialMarker"
          },
          "minItems": 1
        },
        "qrFallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "markerName": {
              "type": "string"
            },
            "placementHint": {
              "type": "string",
              "enum": ["poster_corner", "adjacent_sheet"]
            }
          }
        },
        "anchorOffset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "rotation"],
          "properties": {
            "position": {
              "$ref": "#/$defs/vec3"
            },
            "rotation": {
              "$ref": "#/$defs/vec3"
            }
          }
        }
      }
    },
    "fiducialMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sizeM", "role"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["apriltag", "aruco", "qr"]
        },
        "family": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "sizeM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "role": {
          "type": "string",
          "enum": ["primary-pose", "relock", "session-entry", "debug-calibration"]
        },
        "printPlacement": {
          "type": "string"
        },
        "posterLocalPose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "rotation"],
          "properties": {
            "position": {
              "$ref": "#/$defs/vec3"
            },
            "rotation": {
              "$ref": "#/$defs/vec3"
            }
          }
        },
        "posterLocalCornersM": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/vec3"
          }
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeType", "defaultAnimation", "behaviors", "placement"],
      "properties": {
        "runtimeType": {
          "type": "string",
          "enum": ["unity-gvrm", "gvrm", "scaniverse-source", "default-vrm"]
        },
        "format": {
          "type": "string",
          "enum": ["gaussian-vrm", "scaniverse-source", "vrm"]
        },
        "displayName": {
          "type": ["string", "null"]
        },
        "attribution": {
          "type": ["string", "null"]
        },
        "licenseNote": {
          "type": ["string", "null"]
        },
        "assetBundleUrl": {
          "type": "string",
          "minLength": 1
        },
        "assetBundle": {
          "$ref": "#/$defs/signedAsset"
        },
        "gvrmUrl": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/signedAsset"
          }
        },
        "defaultAnimation": {
          "type": "string",
          "minLength": 1
        },
        "behaviors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "required": ["idle", "explain", "listening", "thinking"],
          "properties": {
            "idle": { "type": "string" },
            "explain": { "type": "string" },
            "listening": { "type": "string" },
            "thinking": { "type": "string" }
          }
        },
        "voice": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["provider", "voiceId", "modelId"],
          "properties": {
            "provider": { "type": "string" },
            "voiceId": { "type": "string" },
            "modelId": { "type": "string" }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativeTo", "position", "rotation", "scale"],
          "properties": {
            "relativeTo": {
              "type": "string",
              "enum": ["poster_anchor", "world", "viewer"]
            },
            "position": {
              "$ref": "#/$defs/vec3"
            },
            "rotation": {
              "$ref": "#/$defs/vec3"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "scriptProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "language", "segments"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["beginner", "master", "professional"]
        },
        "language": {
          "type": "string",
          "enum": ["ja", "en"]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scriptSegment"
          }
        }
      }
    },
    "scriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "panelId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audioUrl": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "$ref": "#/$defs/signedAsset"
        },
        "animation": {
          "type": "string",
          "minLength": 1
        },
        "durationSec": {
          "type": "number",
          "minimum": 0
        },
        "durationEstimateSec": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "evidenceChunkIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "voiceId", "modelId"],
          "properties": {
            "provider": { "type": "string" },
            "voiceId": { "type": "string" },
            "modelId": { "type": "string" }
          }
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["websocketUrl", "defaultProfile", "defaultLanguage", "supportedProfiles", "supportedLanguages"],
      "properties": {
        "websocketUrl": {
          "type": "string",
          "minLength": 1
        },
        "runtimeToken": {
          "type": "string",
          "minLength": 1
        },
        "runtimeTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "defaultProfile": {
          "type": "string",
          "enum": ["beginner", "master", "professional"]
        },
        "defaultLanguage": {
          "type": "string",
          "enum": ["ja", "en"]
        },
        "supportedProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["beginner", "master", "professional"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ja", "en"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowEscalation": {
          "type": "boolean",
          "default": true
        },
        "approvedSimulatedQas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/simulatedQa"
          }
        }
      }
    },
    "simulatedQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "language", "question", "answer", "evidenceChunkIds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": ["beginner", "master", "professional"]
        },
        "language": {
          "type": "string",
          "enum": ["ja", "en"]
        },
        "panelId": {
          "type": ["string", "null"]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "evidenceChunkIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
