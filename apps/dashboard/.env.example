NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=

# New (Nov 2025+) projects: use sb_publishable_... key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects: use anon JWT key. Either one is fine; if both are set the
# publishable key wins.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
