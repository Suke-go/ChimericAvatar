### Mode
APP_ENVIRONMENT=local            # local | staging | production
DEBUG_AUTH_ENABLED=true           # MUST be false outside local
API_PUBLIC_BASE_URL=http://localhost:8000

### Database
# Local SQLite (default):
DATABASE_URL=sqlite:///./chimera_lab.db
# Supabase (use the connection string from Settings → Database):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

### CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

### Asset signing (FastAPI HMAC for LocalStorage; ignored when STORAGE_BACKEND=supabase)
ASSET_URL_SECRET=local-dev-asset-secret-change-me
ASSET_URL_TTL_SECONDS=300

### Storage backend
STORAGE_BACKEND=supabase             # local | supabase
SUPABASE_URL=https://gyckcvkisyhvmrlnmkjv.supabase.co

# New API keys (Nov 2025+; preferred for projects created after the migration).
# sb_secret_... replaces the legacy service_role JWT key.
SUPABASE_SECRET_KEY=Secret keys
# Optional; the dashboard uses NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for the
# browser-safe equivalent. The API server does not need it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_9J9rkzeTbu2UM2SZZRuwtQ_9dXjHLwS

# Legacy keys (pre-Nov 2025 projects). Either fill SUPABASE_SECRET_KEY above
# or SUPABASE_SERVICE_ROLE_KEY here, not both.
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification:
# - New projects sign with asymmetric keys (RS256 default). The server discovers
#   public keys via JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#   automatically; only override SUPABASE_JWKS_URL if you self-host.
# - Legacy projects sign with HS256 using a shared secret. Fill SUPABASE_JWT_SECRET
#   when migrating an old project.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

SUPABASE_STORAGE_BUCKET=session-assets-private

### LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_OCR_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

### TTS
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STREAMING_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

### Limits
MAX_POSTER_UPLOAD_BYTES=52428800
MAX_KNOWLEDGE_UPLOAD_BYTES=83886080
MAX_AVATAR_UPLOAD_BYTES=268435456
# Default base humanoid VRM used when the user uploads only a PLY/SPZ scan.
# Place fem_vroid.vrm (CC0, madjin/vrm-samples) at <AVATAR_BASE_DIR>/<AVATAR_DEFAULT_VRM_FILENAME>.
AVATAR_BASE_DIR=avatar-base
AVATAR_DEFAULT_VRM_FILENAME=fem_vroid.vrm
MAX_KNOWLEDGE_TEXT_CHARS=300000
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=160
